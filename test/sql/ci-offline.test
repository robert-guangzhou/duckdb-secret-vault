# name: test/sql/ci-offline.test
# description: CI 离线冒烟 —— 零 env 依赖,社区 CI 裸跑必绿;env 依赖的 6 个测试由 require-env 在无 env 时整体跳过(skip-requirement,退出码 0)
# group: [sql]
# 全部断言不触碰密钥材料:版本/存储注册/status 形状/设置校验与往返/函数可解析。

require secret_vault

# Rust core 版本可取(FFI 链路通)
query T
SELECT secret_vault_version();
----
0.2.0

# 存储已注册:status 一行,默认 provider=keyring(默认目录可能尚不存在,files 由目录扫描得出)
query TT
SELECT storage, provider FROM secret_vault_status();
----
local_encrypted	keyring

# 未发生任何 lazy 加载:无秘密可见
query I
SELECT count(*) FROM duckdb_secrets();
----
0

# provider 设置校验:非法值明确报错(不静默)
statement error
SET secret_vault_provider = 'kms';
----
secret_vault_provider must be one of

# provider 设置合法值往返(仅存名,不触发密钥读取)
statement ok
SET secret_vault_provider = 'env';

query T
SELECT current_setting('secret_vault_provider');
----
env

statement ok
SET secret_vault_provider = 'keyring';

query T
SELECT current_setting('secret_vault_provider');
----
keyring

# 运维函数签名可解析:status 四列
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM secret_vault_status());
----
4
