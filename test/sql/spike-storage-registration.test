# name: test/sql/spike-storage-registration.test
# description: 阶段零 spike —— 注册 local_encrypted SecretStorage（Dev Plan 阶段零出口判据；TP-00）
# group: [sql]
# plan: plans/secret-vault-duckdb-extension-test-plan.md — TP-00
# SPIKE 语义：落盘仍为明文序列化（加密在阶段二接入），本测试只验证接缝。

require secret_vault

# Rust core 版本可取（corrosion+cbindgen+staticlib 链路通）
query T
SELECT secret_vault_version();
----
0.1.0-spike

# 存储已注册并可显式指定
statement ok
CREATE PERSISTENT SECRET spike_a (TYPE vault_test, URL 'nats://x:4222', USER 'admin', PASSWORD 'spike-mark-PLAIN') IN local_encrypted;

# duckdb_secrets() 可见：persistent + storage 正确
query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 'spike_a' AND persistent AND storage = 'local_encrypted';
----
1

# 脱敏照常（redact_keys 不因自定义存储而失效）
query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 'spike_a' AND secret_string LIKE '%spike-mark-PLAIN%';
----
0

# default_secret_storage 可切换到本存储（SET 无校验，路由在 CREATE 时生效）
statement ok
SET default_secret_storage = 'local_encrypted';

statement ok
CREATE PERSISTENT SECRET spike_default (TYPE vault_test, URL 'nats://y:4222', USER 'u', PASSWORD 'p2');

query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 'spike_default' AND persistent AND storage = 'local_encrypted';
----
1

# 覆盖写（OR REPLACE 语义经由 OnCreateConflict）
statement ok
CREATE OR REPLACE PERSISTENT SECRET spike_a (TYPE vault_test, URL 'nats://x:4222', USER 'admin', PASSWORD 'spike-mark-2') IN local_encrypted;

query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 'spike_a';
----
1

# DROP 走 RemoveSecret
statement ok
DROP PERSISTENT SECRET spike_default;

query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 'spike_default';
----
0

# 清理
statement ok
DROP PERSISTENT SECRET spike_a;
